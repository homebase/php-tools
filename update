#!/usr/bin/env bash

if [ -z "${BASH_VERSION:-}" ]; then
  echo 'Error: this script must be run with bash.' >&2
  exit 1
fi

F=$(readlink -f "$0")
cd "$(dirname "$F")"
repo_dir=$(dirname "$F")

mkdir -p installed

# bold+cyan+on_orange
highlight=$(tput setab 3)$(tput bold)$(tput setaf 4)
normal=$(tput sgr0)

require_command() {
    local name=$1
    if ! [ -x "$(command -v "$name")" ]; then
        echo "Error: $name is not installed." >&2
        exit 1
    fi
}

require_local_composer() {
    if [ ! -x bin/composer ]; then
        echo 'Error: bin/composer is missing. Run ./install composer first.' >&2
        exit 1
    fi
}

if [ $# -eq 0 ]; then
    echo 'specify "all" or specific package to update:'
    echo
    echo installed packages:
    ls installed | sed "s/^/+ /"
    exit 1
fi

if [ ! -w . ]; then
   echo Error: Write Permission Denied
   echo "Option 1: run from root: ${highlight}sudo \"$0\" $* ${normal}"
   echo "Option 2: change file ownership: ${highlight}sudo chown -R ${USER:-$LOGNAME} \"$repo_dir\" ${normal}, then run update command again"
   exit 1
fi


what=$1

if [ "$1" == "all" ]; then
    set -- installed/*
    if [ "$1" = 'installed/*' ]; then
        echo 'no installed packages to update'
        exit 0
    fi

    for file in "$@"
    do
        what=${file#installed/}
        ./update "$what"
    done
    exit
fi

if [ ! -f "scripts/$what.install" ]; then
    echo "unknown package '$what'"
    exit 1
fi

case "$what" in
    composer|php-cs-fixer|phpstan|rector)
        require_local_composer
        ;;
    spartan-test)
        require_command git
        ;;
esac

if [ -f "scripts/$what.update" ]; then
  echo "*** updating $highlight $what $normal"
  bash -x "scripts/$what.update"
else
  echo "*** re-installing $highlight $what $normal"
  bash -x "scripts/$what.install"
fi
date > "installed/$what"
